# NASA FIRMS API Map Key (Optional - for fetching live NRT satellite active fire observations)
# Request a free 32-character key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
VITE_NASA_FIRMS_MAP_KEY=your_32_character_nasa_firms_map_key_here

# Optional: Custom Backend API Base URL (leave empty when deploying with Vercel/Netlify proxy)
VITE_API_BASE_URL=
